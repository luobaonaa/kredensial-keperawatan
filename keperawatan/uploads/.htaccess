Options -Indexes
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

<FilesMatch ".*">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?i:png|jpe?g|webp|gif)$">
    Require all granted
</FilesMatch>

<FilesMatch "\.(?i:php[0-9]?|phtml|phar|cgi|pl|py|sh|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
